{
  "expo": {
    "name": "Ludo After Dark",
    "slug": "ludo-after-dark",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ludoafterdark",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B10",
    "primaryColor": "#00FF87",
    "icon": "./src/assets/images/icon.png",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.ludoafterdark.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0B10"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "bundleIdentifier": "com.ludoafterdark.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0B10"
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./src/assets/fonts/MaterialSymbolsOutlined.ttf"]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
