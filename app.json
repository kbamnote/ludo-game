{
  "expo": {
    "name": "Ludo After Dark",
    "slug": "ludo-after-dark",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ludoafterdark",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B10",
    "primaryColor": "#00FF87",
    "icon": "./src/assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.ludoafterdark.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#191C21"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.ludoafterdark.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo to generate your 3D cartoon avatar. The photo is deleted once the avatar is made.",
        "NSPhotoLibraryUsageDescription": "Choose a photo to generate your 3D cartoon avatar. The photo is deleted once the avatar is made."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0B10"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/MaterialSymbolsOutlined.ttf"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ludo After Dark uses photos you choose to generate your 3D cartoon avatar. Your photo is deleted once the avatar is made.",
          "cameraPermission": "Ludo After Dark uses the camera so you can take a photo for your 3D cartoon avatar. Your photo is deleted once the avatar is made."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a778492e-8578-42ed-8160-3a0009b6ccc7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a778492e-8578-42ed-8160-3a0009b6ccc7"
    }
  }
}
