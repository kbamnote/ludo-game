{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a --no-parallel --max-workers=2"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ludo-game-backend-production-cff1aa99.up.railway.app",
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx3g"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease -PreactNativeArchitectures=arm64-v8a --no-parallel --max-workers=2"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ludo-game-backend-production-cff1aa99.up.railway.app",
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx3g"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
